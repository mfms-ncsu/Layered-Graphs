@inproceedings{2006-GD-Buchheim,
Author = {Buchheim, C and Ebner, D and J\"{u}nger, M and Klau, GW and Mutzel, P and
   Weiskircher, R},
Title = {Exact crossing minimization},
Series = {Lecture Notes in Computer Science},
Year = {2006},
Volume = {3843},
Pages = {37--48},
Booktitle = {Graphy Drawing: 14th International Symposium},
Abstract = {The crossing number of a graph is the minimum number of edge crossings
   in any drawing of the graph into the plane. This very basic property has
   been studied extensively in the literature from a theoretic point of
   view and many bounds exist for a variety of graph classes. In this
   paper, we present the first algorithm able to compute the crossing
   number of general sparse graphs of moderate size and present
   computational results on a popular benchmark set of graphs. The approach
   uses a new integer linear programming formulation of the problem
   combined with strong heuristics and problem reduction techniques, This
   enables us to compute the crossing number for 91 percent of all graphs
   on up to 40 nodes in the benchmark set within a time limit of five
   minutes per graph.},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Buchheim, C (Reprint Author), Univ Cologne, Dept Comp Sci, Cologne, Germany, Germany.
   Univ Cologne, Dept Comp Sci, Cologne, Germany.
